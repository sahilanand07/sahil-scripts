# Copy to .env (git-ignored) and fill in. Never commit the real values.
MORPHEUS_URL=https://vme-manager.example.local
MORPHEUS_TOKEN=

# SSL: set to true for lab appliances with self-signed certificates (never in production).
MORPHEUS_SKIP_TLS_VERIFY=false
# bash scripts only - safer alternative: trust the appliance CA instead of ignoring errors.
# MORPHEUS_CA_CERT=/path/to/appliance-ca.pem

# Tenant script only: password for the new tenant admin (otherwise prompted, or use --generate-password / -GeneratePassword)
TENANT_ADMIN_PASSWORD=
