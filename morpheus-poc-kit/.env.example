# Copy to .env (git-ignored) and fill in. Never commit real values.
MORPHEUS_URL=https://vme-manager.example.local
# API token of a MASTER-tenant admin: User Settings > API Access
MORPHEUS_TOKEN=
# Optional: password for the tenant admin user. If unset, one is generated and printed once.
TENANT_ADMIN_PASSWORD=
# Lab appliances with a self-signed certificate:
#   bash: trust the CA (safer) ...
MORPHEUS_CA_CERT=
#   ... or ignore certificate errors (lab only, never production)
MORPHEUS_SKIP_TLS_VERIFY=false
